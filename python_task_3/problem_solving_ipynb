# Q13. Rotate a List to the Right by K Positions

# Pseudocode

# 1. Start.
# 2. Take a list1,K as input.
# 3. If length of list is equals to 0, return list1.
# 4. use modlus division of k and length of list1 and store it in K.
# 5. If K is not equals to 0 .
# 8. Return the list  before K and after the K values.
# 9. Otherwise return list1
# 10. Print the result.
# 11. Stop. 

# code

def rotate(List11,k):
    if len(List11) == 0:
        return List11
    k = k%len(List11)

    if k!=0:
        return List11[-k:] + List11[:-k]
    else:
        return List11

# Expected Output 

print(rotate([1, 2, 3, 4, 5],2))

# Q14. Find the Maximum Sum of Two Consecutive Elements

# Pseudocode

# 1. Start.
# 2. Take a list as input.
# 3. If values in list is less than 2 return none.
# 4. Create an Max value as varaibel and give the value as 1st and 2nd postion numbers in list.
# 5. Loop through each number in the list1.
# 6. create another variable as total and stored the values i,i+1
# 7. If total which is greater than max
# 8. change the max value as total
# 9. Return the result.
# 10. Print the result.
# 11. Stop. 

# code

# [4, 7, 2, 9, 5]  
def max_sum(num):
    if len(num)<2:
        return None
    max = num[0]+num[1]
    for i in range(len(num)-1):
        total = num[i]+num[i+1]

        if total > max:
            max = total
    return max

# Expected Output  

print(max_sum([4, 7, 2, 9, 5]))

# Q15. Find All Pairs of Numbers Whose Sum Equals a Target

# Pseudocode

# 1. Start.
# 2. Take a list,target as input.
# 3. Create an empty list1.
# 4. Loop through each number in the list1.
# 5. Loop through each number in the list2.
# 6. If value in list1 and value in list2 is equals to target value.
# 7. Add the value list1,list2  the list3.
# 8. Return the result.
# 9. Print the result.
# 10. Stop. 

# code

def Pair_of_number(nums,target):
    result= []
    for i in range(len(nums)):
        for j in range(i+1,len(nums)):
            if nums[i]+nums[j] == target:
                result.append((nums[i],nums[j]))
    return result

# Expected Output 

